{
  "name": "imsg",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:server": "bun --watch server/index.ts",
    "dev:desktop": "bun scripts/dev-desktop.ts",
    "deploy:branch": "bun scripts/deploy-branch.ts",
    "deploy:cleanup": "bun scripts/deploy-cleanup.ts",
    "deploy:status": "bash scripts/deploy-status.sh",
    "deploy:verify": "bun scripts/deploy-verify.ts",
    "deploy:rollback": "bash scripts/desktop-rollback.sh",
    "build": "tsc -b && cd client && bun run build:web",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:fixture": "playwright test --config e2e/fixture.playwright.config.ts",
    "fixture:build": "cd client && EXPO_NO_DOTENV=1 EXPO_NO_CLIENT_ENV_VARS=1 IMSG_VISUAL_FIXTURE=1 bun run expo export --platform web --output-dir ../e2e/fixture/dist",
    "fixture:start": "bun run fixture:build && zsh -c 'exec -a imsg:fixture@triage-desk bun --no-env-file e2e/fixture/start.ts'",
    "lint": "oxlint",
    "start": "bun server/index.ts"
  },
  "dependencies": {
    "hono": "^4.12.30",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bun": "^1.3.14",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2"
  }
}
