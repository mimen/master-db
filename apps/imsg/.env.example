BB_URL=http://localhost:1234
BB_PASSWORD=
HOST=127.0.0.1
PORT=8377
DB_PATH=imsg.db

# Identity graph (Apple Contacts -> master-db). Optional — contact sync is
# skipped with a log line if either site URL or ingest secret is unset.
CONVEX_SITE_URL=https://shiny-gerbil-853.convex.site
APPLE_CONTACTS_INGEST_SECRET=
# Identity mirror and CRM queries. IMSG_SERVER_SECRET must match the Convex
# deployment's IMSG_SERVER_SECRET; it never goes in client/.env.
CONVEX_CLOUD_URL=https://shiny-gerbil-853.convex.cloud
IMSG_SERVER_SECRET=
# The bridge into Convex and the session the Mini mints for clients. Must match
# the Convex deployment's COMMA_BRIDGE_SECRET. Unset turns the bridge off, and
# comma:ai and comma:agent refuse to start.
COMMA_BRIDGE_SECRET=
# Defaults to ~/Library/Messages/chat.db.
# CHATDB_PATH=

# AI lanes (comma:ai) and the agent pane (comma:agent). The key falls back to
# CLAUDE_GPT_GATEWAY_API_KEY, then ~/.cli-proxy-api-key; without one the AI
# surfaces stay off.
AI_GATEWAY_URL=http://127.0.0.1:8317
AI_GATEWAY_KEY=
# AI_FAST_MODEL=gpt-5.6-luna(low)
# AI_VAULT_PATH=/Users/you/Documents/milad-vault
# The agent pane starts only when enabled.
COMMA_AGENT_ENABLED=0
# COMMA_AGENT_ADDENDUM=/absolute/path/to/comma-agent.md
# COMMA_AGENT_SCRATCH=/Users/you/.local/share/comma-agent
# AI_CCS_BIN=ccs

# Optional local whisper.cpp transcription. The app remains available when unset.
WHISPER_BINARY_PATH=/absolute/path/to/whisper-cli
WHISPER_MODEL_PATH=/absolute/path/to/ggml-small.bin
WHISPER_WORK_DIR=.cache/whisper
