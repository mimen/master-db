<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.milad.imsg-agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>unset PROCID PROCID_REF PROCID_OFF; exec -a comma:agent __HOME__/.bun/bin/bun server/agent/main.ts</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO_DIR__/apps/imsg</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__HOME__/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/comma-agent.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/comma-agent.log</string>
</dict>
</plist>
