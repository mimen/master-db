{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "imsg",
  "version": "0.1.0",
  "identifier": "com.milad.imsg.desktop",
  "build": {
    "devUrl": "https://milads-mac-mini.taild31e9a.ts.net:8447",
    "frontendDist": "https://milads-mac-mini.taild31e9a.ts.net:8447"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "imsg",
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 16, "y": 20 },
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
